<!DOCTYPE html>
<html lang="en">
<head>
    <%-include('../partials/head.ejs');%>
    <%-include('../partials/style.ejs');%>
    <title><%=title%></title>
</head>
<body>
    <%-include('../partials/nav.ejs');%>
    <div class="container mt-4 content">
        <h1>API Documentation</h1>
        <div class="card mt-2">
            <div class="card-body">
                Welcome to the Healthy Fruits and Veggies API Documentation! This API provides detailed nutritional insights and health suitability information for various fruits and vegetables, specifically for individuals with diabetes, high blood pressure, and uric acid concerns.
            </div>
        </div>

        <h4 class="mt-4 mb-3">Base Url </h4>
        <div class="card">
            <div class="card-body">
                <b><code>www.9ine.com/api</code></b>
            </div>
        </div>

        <h4 class="mt-4 mb-3">Endpoints </h4>
        <div class="card">
            <div class="card-body">
                <table class="table">
                    <tbody>
                      <tr>
                        <th scope="row"><code>/allItems</code></th>
                        <td colspan="2">Retreive all items, including fruits and vegetables.</td>
                      </tr>
                      <tr>
                        <th scope="row"><code>/fruits</code></th>
                        <td colspan="2">Retreive all fruits,</td>
                      </tr>
                      <tr>
                        <th scope="row"><code>/vegetables</code></th>
                        <td colspan="2">Retreive all vegetables.</td>
                      </tr>
                      <tr>
                        <th scope="row" colspan="2">Getting Random Items</th>
                      </tr>
                      <tr>
                        <th scope="row"><code>/allItems/random</code></th>
                        <td colspan="2">Retreive a random item from all fruits and vegetables.</td>
                      </tr>
                      <tr>
                        <th scope="row"><code>/fruits/random</code></th>
                        <td colspan="2">Retreive a random fruit from all friuts.</td>
                      </tr>
                      <tr>
                        <th scope="row"><code>/vegetables/random</code></th>
                        <td colspan="2">Retreive a random vegetable from all vegetables.</td>
                      </tr>
                    </tbody>
                  </table>
            </div>
        </div>

        <h4 class="mt-4 mb-3">Query Parameters </h4>
        <div class="card">
            <div class="card-body">
                <table class="table">
                    <tbody>
                      <tr>
                        <th scope="col">Query</th>
                        <th scope="col">Description</th>
                        <th scope="col">Example</th>
                      </tr>
                      <tr>
                        <th scope="row"><code>/allItems?search=</code></th>
                        <td colspan="1">Search by keyword. It could be a name or regional name.</td>
                        <td colspan="1"><code>/allItems?search=Mango</code></td>
                      </tr>
                      <tr>
                        <th scope="row"><code>/allItems?category=</code></th>
                        <td colspan="1">Search all vegetables and fruits by categories: <code style="color: black;">sugarfriendly</code>, <code style="color: black;">bpfriendly</code>, <code style="color: black;">uricAcidfriendly</code></td>
                        <td colspan="1"><code>/allItems?category=sugarfriendly</code></td>
                      </tr>
                      <tr>
                        <th scope="row"><code>/fruits?category=</code></th>
                        <td colspan="1">Search all fruits by categories: <code style="color: black;">sugarfriendly</code>, <code style="color: black;">bpfriendly</code>, <code style="color: black;">uricAcidfriendly</code></td>
                        <td colspan="1"><code>/fruits?category=bpfriendly</code></td>
                      </tr>
                      <tr>
                        <th scope="row"><code>/vegetables?category=</code></th>
                        <td colspan="1">Search all vegetables by categories: <code style="color: black;">sugarfriendly</code>, <code style="color: black;">bpfriendly</code>, <code style="color: black;">uricAcidfriendly</code></td>
                        <td colspan="1"><code>/vegetables?category=uricAcidfriendly</code></td>
                      </tr>
                    </tbody>
                  </table>
            </div>
        </div>


    </div>

    <footer class="mt-4 bg-color bg-dark">
        <div class="container text-light text-center">
            <!-- <p class="display-5 mb-3">9iNe</p> -->
            <small class="text-white-50">&copy; Copyright by 9iNe. All rights reserved.</small>
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const currentPage = window.location.pathname;
            const navLinks = document.querySelectorAll(".navbar .nav-link");
      
            navLinks.forEach(link => {
                if (link.getAttribute("href") === currentPage) {
                    link.classList.add("active");
                } else {
                    link.classList.remove("active");
                }
            });
        });
      </script>
</body>
</html>