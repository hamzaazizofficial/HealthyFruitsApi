<!DOCTYPE html>
<html lang="en">
<head>
    <%-include('./partials/head.ejs');%>
    <%-include('./partials/style.ejs');%>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%=title%></title>
</head>
<body>
    <%-include('./partials/nav.ejs');%>
    <div class="container mt-4 content">
         <h1>API Documentation</h1>

        <div class="card mt-2">
            <div class="card-body">
                Welcome to the Healthy Fruits and Veggies API Documentation! This API provides detailed nutritional insights and health suitability information for various fruits and vegetables, specifically for individuals with diabetes, high blood pressure, and uric acid concerns.
            </div>
        </div>

        <h4 class="mt-4 mb-3">Base URL</h4>
        <div class="card">
            <div class="card-body">
                <b><code>https://fruitsandveggies.vercel.app/api</code></b>
            </div>
        </div>

        <h4 class="mt-4 mb-3">Endpoints</h4>
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table">
                        <tbody>
                          <tr><th scope="row"><code>/allItems</code></th><td>Retrieve all items, including fruits and vegetables.</td></tr>
                          <tr><th scope="row"><code>/fruits</code></th><td>Retrieve all fruits.</td></tr>
                          <tr><th scope="row"><code>/vegetables</code></th><td>Retrieve all vegetables.</td></tr>
                          <tr><th scope="row" colspan="2">Getting Random Items</th></tr>
                          <tr><th scope="row"><code>/allItems/random</code></th><td>Retrieve a random item from all fruits and vegetables.</td></tr>
                          <tr><th scope="row"><code>/fruits/random</code></th><td>Retrieve a random fruit.</td></tr>
                          <tr><th scope="row"><code>/vegetables/random</code></th><td>Retrieve a random vegetable.</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <h4 class="mt-4 mb-3">Query Parameters</h4>
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table">
                        <tbody>
                          <tr>
                            <th scope="col">Param</th>
                            <th scope="col">Description</th>
                            <th scope="col">Example</th>
                          </tr>
                          <tr>
                            <th scope="row"><code>search</code></th>
                            <td colspan="1">Search by keyword. It could be a name or regional name.</td>
                            <td colspan="1"><code>/allI?search=Mango</code></td>
                          </tr>
                          <tr>
                            <th scope="row"><code>category</code></th>
                            <td colspan="1">List all items, vegetables and fruits by health suitable categories: <code style="color: black;">sugarfriendly</code>, <code style="color: black;">bpfriendly</code>, <code style="color: black;">uricAcidfriendly</code></td>
                            <td colspan="1"><code>/allI?category=sugarfriendly</code></td>
                          </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>

    <footer class="mt-4 bg-dark text-light text-center py-3">
        <div class="container text-light text-center">
            <small class="text-white-50">&copy; Copyright by <span style="color: #0BDA51;">9iNe</span>. All rights reserved.</small>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const currentPage = window.location.pathname;
            document.querySelectorAll(".navbar .nav-link").forEach(link => {
                link.classList.toggle("active", link.getAttribute("href") === currentPage);
            });
        });
    </script>

    <style>
        @media (max-width: 768px) {
            .container { padding: 10px; }
            .table-responsive { overflow-x: auto; }
            footer { padding: 10px; }
            .navbar { flex-direction: column; align-items: center; }
            .navbar-nav { text-align: center; }
            .navbar .nav-link { display: block; padding: 10px; }
        }
    </style>
</body>
</html>
